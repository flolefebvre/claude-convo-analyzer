// Claude Conversation Analyzer — data model.
// Eleven tables per ADR-0001 (docs/adr/0001-token-accounting-and-data-model.md).
// Prisma 7: `prisma-client` generator + @prisma/adapter-better-sqlite3 driver adapter.
// The generated client output is gitignored (commit schema + migrations only).
// The Refresh writes these tables WITHOUT Prisma (ADR-0005): mirror any column
// change in `refresh-statements.ts`, beside this file. The equivalence test
// (`stored-data-equivalence.test.ts`) catches a miss.

generator client {
  provider = "prisma-client"
  output   = "./generated"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

/// One per Project path: the directory its Conversations run in (GLOSSARY.md).
model Project {
  id            Int            @id @default(autoincrement())
  /// Absolute path, per the records' `cwd` (see `ParsedSession.projectPath`).
  path          String         @unique
  conversations Conversation[]

  @@map("project")
}

/// One per top-level `<sessionId>.jsonl`; the user-facing row.
model Conversation {
  id                     Int     @id @default(autoincrement())
  /// The session id (file stem of `<sessionId>.jsonl`).
  sessionId              String  @unique @map("session_id")
  projectId              Int     @map("project_id")
  /// The Conversation's own records stated its Project path; false when it
  /// was borrowed from a sibling in its log folder or decoded from the folder name.
  projectPathFromRecords Boolean @default(false) @map("project_path_from_records")

  /// Human-readable name from an `ai-title` record (may be null).
  title     String?
  gitBranch String? @map("git_branch")
  /// Claude Code version that produced the session.
  ccVersion String? @map("cc_version")

  /// Source file path on disk.
  sourcePath    String @map("source_path")
  /// Source file mtime (epoch ms) — incremental-refresh change key.
  sourceMtime   BigInt @map("source_mtime")
  /// Source file size in bytes — incremental-refresh change key.
  sourceSize    BigInt @map("source_size")
  /// Parser version these rows were produced by; a mismatch with the current
  /// `PARSER_VERSION` (refresh.ts) forces a one-time re-parse after an upgrade.
  parserVersion Int    @default(0) @map("parser_version")

  /// Set when the first message's parentUuid resolves into a prior session (--resume/fork).
  continuedFromConversationId Int? @map("continued_from_conversation_id")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  continuedFrom Conversation?  @relation("ConversationContinuation", fields: [continuedFromConversationId], references: [id], onDelete: SetNull)
  continuations Conversation[] @relation("ConversationContinuation")
  agents        Agent[]
  messages      Message[]
  prLinks       PrLink[]
  turnDurations TurnDuration[]
  apiRequests   ApiRequest[]

  @@index([projectId])
  @@map("conversation")
}

/// One per transcript (main thread AND sub-agent). Self-referential lineage.
model Agent {
  id             Int @id @default(autoincrement())
  conversationId Int @map("conversation_id")

  /// NULL ⇒ root/main agent.
  parentAgentId Int? @map("parent_agent_id")

  /// On-disk agent id from `agent-<id>.jsonl` (sub-agents only; NULL for root).
  externalAgentId    String? @map("external_agent_id")
  /// For sub-agents: the main-thread message (Agent tool call) that launched it.
  spawnedByMessageId Int?    @map("spawned_by_message_id")

  /// e.g. `Explore`, `Plan`; NULL for the main thread.
  agentType     String? @map("agent_type")
  /// Concrete Anthropic model the agent ran on (sub-agents report once).
  resolvedModel String? @map("resolved_model")
  durationMs    BigInt? @map("duration_ms")
  toolCallCount Int?    @map("tool_call_count")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentAgent  Agent?       @relation("AgentLineage", fields: [parentAgentId], references: [id], onDelete: SetNull)
  childAgents  Agent[]      @relation("AgentLineage")

  /// The Agent-tool message that spawned this sub-agent.
  spawnedBy   Message?     @relation("AgentSpawn", fields: [spawnedByMessageId], references: [id], onDelete: SetNull)
  messages    Message[]    @relation("AgentMessages")
  toolCalls   ToolCall[]
  apiRequests ApiRequest[]

  @@index([conversationId])
  @@index([parentAgentId])
  @@map("agent")
}

/// One row per user or assistant message (assistant turns deduplicated by message.id).
model Message {
  id             Int @id @default(autoincrement())
  conversationId Int @map("conversation_id")
  agentId        Int @map("agent_id")

  /// Source message id (Anthropic `message.id`); the dedup key for assistant turns.
  messageId String? @map("message_id")
  /// Record `uuid` — the cross-session key for continued-from resolution (a
  /// child's first-message `parentUuid` points at the parent message's `uuid`).
  uuid      String? @map("uuid")
  /// `user` | `assistant`.
  role      String
  /// User Message kind (GLOSSARY.md, Message): `prompt` | `inter-agent` |
  /// `task-notification` | `tool-result` | `meta`. A free string, the single
  /// discriminator. NULL on assistant rows — they carry no meaningful kind. The
  /// transcript renders assistant rows plus user rows of the first three kinds.
  kind      String?
  /// The display body. For an Inter-agent message, the message without its
  /// delivery wrapper; for a Task notification, its `result` (or `event`).
  text      String?
  /// The user Message's extras as JSON — sender, hand-back, plugin, mid-turn,
  /// notification task id/status/summary — in the normalized shape of
  /// `messageOriginSchema` (`src/core/parse.ts`), not the raw log `origin`.
  /// Validated when read; NULL when there are none and on assistant rows.
  origin    String?

  /// Token split — NULL for user messages (no usage of their own).
  inputTokens           Int? @map("input_tokens")
  outputTokens          Int? @map("output_tokens")
  cacheCreation5mTokens Int? @map("cache_creation_5m_tokens")
  cacheCreation1hTokens Int? @map("cache_creation_1h_tokens")
  cacheReadTokens       Int? @map("cache_read_tokens")

  /// Resolved model for this turn (assistant `message.model`).
  model String?

  /// Reasoning effort of this assistant turn, verbatim from the record's
  /// top-level `effort` field (`high`, `xhigh`, `medium`, …). NULL on user rows
  /// and on turns from Claude Code versions that did not record it. Kept as a
  /// free string, NOT an enum: future levels must flow through without a code
  /// change. Uniform-vs-mixed and change markers are derived at read time.
  effort String?

  /// The text of this assistant turn's `thinking` blocks, joined in order
  /// across its lines (log-format §6): a short summary, never the reasoning
  /// itself. NULL when every block is empty — most are — on user rows, and on
  /// turns without thinking.
  thinkingText       String? @map("thinking_text")
  /// Time this assistant turn spent thinking: the sum of its lines'
  /// `thinkingDurationMs` (a turn with two thinking lines logs a duration on
  /// each, the second a few ms). NULL on user rows, on turns without thinking,
  /// and on logs older than 2.1.287.
  thinkingDurationMs Int?    @map("thinking_duration_ms")

  /// Per-turn attribution — what drove this assistant message.
  attributionSkill     String? @map("attribution_skill")
  attributionAgent     String? @map("attribution_agent")
  attributionPlugin    String? @map("attribution_plugin")
  attributionMcpServer String? @map("attribution_mcp_server")

  permissionMode  String? @map("permission_mode")
  /// True when the turn recorded an API error.
  isApiError      Boolean @default(false) @map("is_api_error")
  apiErrorMessage String? @map("api_error_message")

  /// Record timestamp (epoch ms).
  timestamp BigInt?

  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent                    Agent        @relation("AgentMessages", fields: [agentId], references: [id], onDelete: Cascade)
  spawnedAgents            Agent[]      @relation("AgentSpawn")
  toolCalls                ToolCall[]
  apiRequests              ApiRequest[] @relation("ApiRequestTurn")
  /// The API requests that were this Turn's Failed attempts.
  failedAttemptApiRequests ApiRequest[] @relation("ApiRequestFailedAttempt")

  @@index([conversationId])
  @@index([agentId])
  @@index([messageId])
  @@index([uuid])
  @@map("message")
}

/// One per `tool_use` block.
model ToolCall {
  id        Int @id @default(autoincrement())
  messageId Int @map("message_id")
  agentId   Int @map("agent_id")

  /// `tool_use` block id.
  toolUseId String? @map("tool_use_id")
  /// Tool name (e.g. `Bash`, `Read`, `Skill`, `Agent`).
  name      String
  /// Full tool input, serialized JSON (small; powers skill/CLI detection).
  inputJson String  @map("input_json")

  /// Tool result: whole for an `Agent` call, else truncated to ~10k chars (NULL until paired).
  resultText      String? @map("result_text")
  /// True when the result was truncated.
  resultTruncated Boolean @default(false) @map("result_truncated")
  /// Full (untruncated) result length — a token-cost proxy.
  resultCharSize  Int?    @map("result_char_size")
  /// True when the tool result was an error.
  isError         Boolean @default(false) @map("is_error")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([agentId])
  @@map("tool_call")
}

/// PRs surfaced in a conversation (`pr-link` records).
model PrLink {
  id             Int @id @default(autoincrement())
  conversationId Int @map("conversation_id")

  prNumber     Int?    @map("pr_number")
  prUrl        String  @map("pr_url")
  prRepository String? @map("pr_repository")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("pr_link")
}

/// Wall-clock turn timings (`system/turn_duration` records).
model TurnDuration {
  id             Int @id @default(autoincrement())
  conversationId Int @map("conversation_id")

  durationMs   BigInt @map("duration_ms")
  messageCount Int    @map("message_count")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("turn_duration")
}

/// One per `api-request` record of the Conversation's log files, Main thread
/// and Sub-agents alike (docs/conversation-log-format.md, §9): an API request
/// as Claude Code 2.1.300+ logs it, its system prompt, tool set and messages
/// each stored once, under their hash, in `system_prompt`, `tool_set` and
/// `sent_message`.
model ApiRequest {
  id                       Int  @id @default(autoincrement())
  conversationId           Int  @map("conversation_id")
  /// The Agent of the log file holding the record.
  agentId                  Int  @map("agent_id")
  /// The assistant Message of the Turn whose `requestRef` names this record,
  /// among the Turns of the same file; NULL when none does (a request then
  /// retried, or never answered).
  messageId                Int? @map("message_id")
  /// The assistant Message of the Turn that owns this record as a Failed
  /// attempt (log-format §9, Retries): no Turn answered it, and the next
  /// request of its file resent it — the same `requestDigest`, its `base` this
  /// record — that request's Turn, or the owner of that request in turn. NULL
  /// otherwise.
  failedAttemptOfMessageId Int? @map("failed_attempt_of_message_id")

  /// The record's own `id`: what an assistant record's `requestRef` names.
  recordId              String  @map("record_id")
  /// `base`: the `recordId` of the request whose first `keptMessageCount`
  /// messages this one's start with; NULL when its tail holds them all.
  baseRecordId          String? @map("base_record_id")
  /// `keep`: how many of the base request's messages it starts with.
  keptMessageCount      Int     @map("kept_message_count")
  /// `tail`: the hashes of the messages that follow, in order, as a JSON array.
  tailMessageHashesJson String  @map("tail_message_hashes_json")
  /// `params` as JSON, without `safeguards`, which is never stored (ADR-0007).
  parametersJson        String  @map("parameters_json")
  /// `cacheControl` as JSON: `[{path, value}]`, where its `cache_control` markers go.
  cacheBreakpointsJson  String  @map("cache_breakpoints_json")
  /// `repl_main_thread`, `sdk`, `agent:builtin:<type>`, …
  querySource           String? @map("query_source")
  /// The sha256 of the whole request body, as Claude Code computed it.
  requestDigest         String? @map("request_digest")
  /// When the request was sent (epoch ms).
  sentAt                BigInt? @map("sent_at")
  /// Its 0-based place among the `api-request` records of its file: the
  /// previous API request of an Agent is the previous one in file order.
  positionInFile        Int     @map("position_in_file")
  /// NULL when its file holds no `api-request-shape` under its `shapeHash`.
  systemPromptHash      String? @map("system_prompt_hash")
  /// NULL when its file holds no `api-request-shape` under its `shapeHash`.
  toolSetHash           String? @map("tool_set_hash")

  conversation           Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent                  Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  message                Message?      @relation("ApiRequestTurn", fields: [messageId], references: [id], onDelete: SetNull)
  failedAttemptOfMessage Message?      @relation("ApiRequestFailedAttempt", fields: [failedAttemptOfMessageId], references: [id], onDelete: SetNull)
  systemPrompt           SystemPrompt? @relation(fields: [systemPromptHash], references: [hash], onDelete: Restrict)
  toolSet                ToolSet?      @relation(fields: [toolSetHash], references: [hash], onDelete: Restrict)

  @@index([conversationId])
  @@index([messageId])
  @@index([failedAttemptOfMessageId])
  @@index([agentId, positionInFile])
  @@index([systemPromptHash])
  @@index([toolSetHash])
  @@map("api_request")
}

/// One per distinct system prompt an API request sent, shared across
/// Conversations; the Refresh deletes it once no request references it.
model SystemPrompt {
  /// The sha256 hex of the blocks' canonical JSON (`canonical-json.ts`): its
  /// identity only, never what is shown.
  hash       String @id
  /// The system blocks as logged, key order kept: what the model saw. When
  /// logs spell the same blocks in two key orders, the smallest spelling.
  blocksJson String @map("blocks_json")

  apiRequests ApiRequest[]

  @@map("system_prompt")
}

/// One per distinct set of tool definitions an API request sent, shared
/// across Conversations; the Refresh deletes it once no request references it.
model ToolSet {
  /// The sha256 hex of the definitions' canonical JSON (`canonical-json.ts`):
  /// its identity only, never what is shown.
  hash      String @id
  /// The tool definitions as logged, in order, key order kept: what the model
  /// saw. When logs spell the same set in two key orders, the smallest spelling.
  toolsJson String @map("tools_json")

  apiRequests ApiRequest[]

  @@map("tool_set")
}

/// One per distinct message an API request's `tail` names, shared across
/// Conversations; the Refresh deletes it once no request's tail names it.
model SentMessage {
  /// The sha256 hex of the message's canonical JSON (`canonical-json.ts`), a
  /// string `content` first rewritten as one text block: the hash a `tail`
  /// names, its identity only, never what is shown.
  hash        String @id
  /// The message as logged, key order and a string `content` kept: what the
  /// model saw. When logs spell the same message two ways, the smallest spelling.
  messageJson String @map("message_json")

  @@map("sent_message")
}
