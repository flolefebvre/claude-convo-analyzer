{
  "name": "claude-convo-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "A local-only web app that analyzes your Claude Code conversation logs for per-conversation token usage and cost.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flolefebvre/claude-convo-analyzer.git"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "next dev",
    "seed": "tsx scripts/seed.ts",
    "bench:refresh": "tsx scripts/bench-refresh.ts",
    "dev:seed": "tsx scripts/dev-seed.ts",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "check": "tsx scripts/gate.ts format:check+lint+duplication+typecheck,test:changed",
    "gate": "tsx scripts/gate.ts format:check+lint+duplication+typecheck,test+build,e2e",
    "build": "tsx scripts/build.ts",
    "e2e": "playwright test",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "duplication": "jscpd",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed ${CHECK_BASE:-origin/main}",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "gen": "next-pipe gen",
    "postinstall": "prisma generate && next-pipe gen",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check ."
  },
  "dependencies": {
    "@flefebvre/next-pipe": "^2.0.0",
    "@flefebvre/next-sse": "^0.2.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.21.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/playwright": "16.4.2",
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "jscpd": "^4.2.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
